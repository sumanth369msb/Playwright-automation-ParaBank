{
  "name": "banking-automation-framework",
  "version": "2.0.0",
  "description": "Enterprise-grade banking test automation framework using Playwright - targeting ParaBank demo application",
  "main": "index.js",
  "scripts": {
    "test": "npx playwright test",
    "test:headed": "npx playwright test --headed",
    "test:chromium": "npx playwright test --project=chromium",
    "test:firefox": "npx playwright test --project=firefox",
    "test:webkit": "npx playwright test --project=webkit",
    "test:mobile": "npx playwright test --project=mobile-chrome --project=mobile-safari",
    "test:smoke": "npx playwright test --project=smoke",
    "test:regression": "npx playwright test --project=regression",
    "test:auth": "npx playwright test tests/auth/",
    "test:accounts": "npx playwright test tests/accounts/",
    "test:transfers": "npx playwright test tests/transfers/",
    "test:billpay": "npx playwright test tests/bill-pay/",
    "test:loans": "npx playwright test tests/loans/",
    "test:e2e": "npx playwright test tests/e2e/",
    "test:api": "npx playwright test tests/api/",
    "test:parallel": "npx playwright test --workers=8",
    "test:shard-1": "npx playwright test --shard=1/4",
    "test:shard-2": "npx playwright test --shard=2/4",
    "test:shard-3": "npx playwright test --shard=3/4",
    "test:shard-4": "npx playwright test --shard=4/4",
    "test:ci": "npx playwright test --project=chromium --reporter=list,json",
    "test:debug": "npx playwright test --debug",
    "test:trace": "npx playwright test --trace on",
    "report": "npx playwright show-report",
    "codegen": "npx playwright codegen https://parabank.parasoft.com/parabank",
    "codegen:mobile": "npx playwright codegen --device='iPhone 12' https://parabank.parasoft.com/parabank",
    "lint": "npx tsc --noEmit",
    "clean": "rm -rf test-results playwright-report",
    "clean:all": "rm -rf test-results playwright-report node_modules",
    "install:browsers": "npx playwright install --with-deps"
  },
  "keywords": [
    "playwright",
    "automation",
    "banking",
    "testing",
    "e2e",
    "typescript"
  ],
  "author": "Banking QA Team",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  }
}
